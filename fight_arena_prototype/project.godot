[application]
config/name="Fight Arena Prototype"
run/main_scene="res://scenes/arena.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[input]
attack_jab={"deadzone":0.2,"events":[Object(InputEventMouseButton,"button_index":1),Object(InputEventKey,"physical_keycode":70)]}
attack_cross={"deadzone":0.2,"events":[Object(InputEventMouseButton,"button_index":2),Object(InputEventKey,"physical_keycode":71)]}
jump={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":32)]}

[physics]
common/enable_pause_aware_picking=true

[gui]
theme/default_font_multichannel_signed_distance_field=true

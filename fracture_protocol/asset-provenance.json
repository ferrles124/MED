      "roles": [
        {
          "description": "Sizin saldırı ve savunma takımlarınızı ilk bakışta ayıran, özgün ve okunaklı siluetlere sahip low-poly 3D karakterler; temel hareket, nişan, ateş, yeniden doldurma, vurulma ve ölüm durumlarını destekler.",
          "id": "team_characters",
          "label": "Renk kodlu takım karakterleri"
        },
        {
          "description": "Sizin nişan alma, ateş etme, geri tepme, yeniden doldurma ve silah değiştirme mekaniklerinizi görünür kılan birkaç özgün low-poly 3D silah ile uyumlu birinci şahıs kol/el sunumu.",
          "id": "first_person_weapons",
          "label": "Birinci şahıs silah seti"
        },
        {
          "description": "Botların ellerinde ve gerektiğinde oyun dünyasında okunabilen, birinci şahıs silahlarıyla aynı özgün tasarım dilini kullanan hafif low-poly 3D silah görünümleri.",
          "id": "world_weapon_models",
          "label": "Dünya silah modelleri"
        },
        {
          "description": "Sizin kurma, etkinleşme, geri sayım ve imha etkileşimlerinizi açıkça anlatan; mevcut oyunlardaki bomba tasarımlarını kopyalamayan özgün low-poly 3D hedef cihazı ve basit durum göstergeleri.",
          "id": "objective_device",
          "label": "Kurulabilir hedef cihazı"
        },
        {
          "description": "Sizin küçük haritanızı yalnızca küplerden oluşan bir prototipe dönüştürmeden kurmak için duvar, kapı, geçit, köşe, merdiven, siper ve hedef alanı parçalarından oluşan karakterli low-poly 3D modüler çevre seti.",
          "id": "modular_map_kit",
          "label": "Modüler taktik harita kiti"
        },
        {
          "description": "Sizin saldırı ve savunma hedef alanlarınızı oynanış sırasında anlaşılır kılan özgün 3D zemin işaretleri, sınır göstergeleri ve takım renkleriyle uyumlu sade materyal vurguları.",
          "id": "objective_site_markers",
          "label": "Hedef alanı işaretleri"
        },
        {
          "description": "Sizin atış, isabet, hasar ve ölüm sistemlerinizi okunaklı kılan sade namlu parlaması, mermi izi, darbe izi ve hasar yönü geri bildirimi; abartısız low-poly görsel dili korur.",
          "id": "combat_feedback",
          "label": "Çatışma geri bildirimi"
        },
        {
          "description": "Sizin temiz Godot Control arayüzünüzde nişangâh, sağlık, mühimmat, tur süresi, takım durumu, kredi, satın alma fazı, cihaz durumu ve tur sonu skor özetini Türkçe ve açık biçimde sunar.",
          "id": "turkish_hud",
          "label": "Türkçe taktik HUD ve ekranlar"
        }
      ]
    },
    "overflowEvents": 0,
